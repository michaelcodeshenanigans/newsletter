{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelcodeshenanigans.github.io/newsletter/schemas/newsletter.v1.schema.json",
  "title": "Weekly AI and Agentic Systems Newsletter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "revision",
    "generated_at",
    "timezone",
    "coverage",
    "title",
    "summary",
    "developments",
    "devops_impacts",
    "bring_to_work",
    "watchouts",
    "citations",
    "telegram_text"
  ],
  "properties": {
    "schema_version": {
      "const": "newsletter.v1"
    },
    "issue_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Asia/Jerusalem"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "developments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/development"}
    },
    "devops_impacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/impact"}
    },
    "bring_to_work": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/action"}
    },
    "watchouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/watchout"}
    },
    "citations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/citation"}
    },
    "telegram_text": {
      "type": "string",
      "minLength": 200,
      "maxLength": 12000
    }
  },
  "$defs": {
    "citationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^src-[0-9]{2,3}$"
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "event_date",
        "what_changed",
        "why_it_matters",
        "platform_impact",
        "recommended_action",
        "watchouts",
        "confidence",
        "score",
        "citation_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 8, "maxLength": 180},
        "status": {
          "enum": [
            "ga",
            "preview",
            "limited",
            "open_source",
            "announced_dated",
            "announced_undated",
            "unconfirmed"
          ]
        },
        "event_date": {"type": "string", "format": "date"},
        "availability": {"type": "string", "maxLength": 600},
        "what_changed": {"type": "string", "minLength": 20, "maxLength": 1800},
        "why_it_matters": {"type": "string", "minLength": 20, "maxLength": 900},
        "platform_impact": {"type": "string", "minLength": 20, "maxLength": 1200},
        "recommended_action": {"type": "string", "minLength": 10, "maxLength": 700},
        "watchouts": {"type": "string", "minLength": 5, "maxLength": 900},
        "confidence": {"enum": ["high", "medium", "low"]},
        "score": {"type": "integer", "minimum": 0, "maximum": 21},
        "citation_ids": {"$ref": "#/$defs/citationIds"},
        "prior_issue": {"type": ["string", "null"], "format": "uri-reference"},
        "new_delta": {"type": ["string", "null"], "maxLength": 700}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "text", "citation_ids"],
      "properties": {
        "area": {
          "enum": [
            "architecture",
            "deployment",
            "reliability",
            "observability",
            "security",
            "governance",
            "cost",
            "developer-workflow",
            "data-residency",
            "vendor-coupling"
          ]
        },
        "text": {"type": "string", "minLength": 20, "maxLength": 1000},
        "citation_ids": {"$ref": "#/$defs/citationIds"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "what", "fit", "effort", "next_step", "citation_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 4, "maxLength": 140},
        "what": {"type": "string", "minLength": 10, "maxLength": 700},
        "fit": {"type": "string", "minLength": 10, "maxLength": 700},
        "effort": {"enum": ["low", "medium", "high"]},
        "next_step": {"type": "string", "minLength": 10, "maxLength": 700},
        "citation_ids": {"$ref": "#/$defs/citationIds"}
      }
    },
    "watchout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citation_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 10, "maxLength": 900},
        "citation_ids": {"$ref": "#/$defs/citationIds"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "published_at", "source_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^src-[0-9]{2,3}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 300},
        "publisher": {"type": "string", "minLength": 2, "maxLength": 120},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "published_at": {"type": ["string", "null"], "format": "date"},
        "source_type": {
          "enum": ["primary", "paper", "official-project", "government", "secondary"]
        }
      }
    }
  }
}
